{
  "name": "amrss-uploader",
  "version": "0.1.0",
  "private": true,
  "description": "AMRSS offline de-identification and upload client for WHONET laboratories",
  "author": "AMRSS",
  "homepage": "https://github.com/Afrinicky/AMRSS",
  "main": "dist/main/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.renderer.json && node -e \"require('fs').cpSync('src/renderer','dist/renderer',{recursive:true,filter:p=>!p.endsWith('.ts')})\"",
    "dev": "npm run build && npm run rebuild:electron && electron .",
    "test": "npm run build && node --test 'dist/test/**/*.test.js'",
    "lint": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.renderer.json",
    "package": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "rebuild:electron": "electron-rebuild -f -w better-sqlite3",
    "rebuild:node": "npm rebuild better-sqlite3",
    "pretest": "npm run rebuild:node"
  },
  "dependencies": {
    "better-sqlite3": "11.8.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.12",
    "@types/node": "22.10.7",
    "electron": "33.3.1",
    "electron-builder": "^25.1.8",
    "typescript": "5.7.3",
    "@electron/rebuild": "^3.7.1"
  }
}
