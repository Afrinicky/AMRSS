# AMRSS configuration template.
#
# Copy to .env and fill in real values. .env is gitignored and must never be
# committed. Generate each key separately:
#
#   python -m amrss.cli gen-key --bytes 64
#
# The three keys below MUST be different from one another: reusing one secret
# for signing, encryption and pseudonymisation collapses three separate blast
# radii into one. Configuration validation refuses identical keys in production.

AMRSS_ENVIRONMENT=development
AMRSS_DEBUG=false

# --- Database -----------------------------------------------------------
AMRSS_DATABASE_URL=postgresql+psycopg://amrss:CHANGE_ME@localhost:5432/amrss
# Optional lower-privilege DSN used for reporting queries.
# AMRSS_DATABASE_URL_READONLY=postgresql+psycopg://amrss_ro:CHANGE_ME@localhost:5432/amrss
AMRSS_DB_STATEMENT_TIMEOUT_MS=15000

# --- Cryptography -------------------------------------------------------
# HS512 requires >= 64 bytes of key material (RFC 7518 section 3.2).
AMRSS_JWT_SECRET=
# Encrypts direct patient identifiers at rest.
AMRSS_FIELD_ENCRYPTION_KEY=
# Derives stable patient pseudonyms. Rotating this BREAKS existing linkage -
# see docs/security.md before changing it.
AMRSS_PSEUDONYM_HMAC_KEY=

AMRSS_ACCESS_TOKEN_TTL_SECONDS=900
AMRSS_REFRESH_TOKEN_TTL_SECONDS=43200

# --- Authentication policy ---------------------------------------------
AMRSS_PASSWORD_MIN_LENGTH=12
AMRSS_MAX_FAILED_LOGINS=5
AMRSS_LOCKOUT_SECONDS=900
AMRSS_REQUIRE_MFA_FOR_ROLES=["admin","data_manager"]

# --- Transport ----------------------------------------------------------
# Explicit allowlist only. "*" and http:// origins are refused in production.
AMRSS_CORS_ALLOW_ORIGINS=["https://amrss.example.org"]
AMRSS_TRUSTED_HOSTS=["localhost","127.0.0.1"]
AMRSS_SESSION_COOKIE_SECURE=true

# --- Rate limiting ------------------------------------------------------
AMRSS_LOGIN_RATE_LIMIT_PER_MINUTE=10
AMRSS_API_RATE_LIMIT_PER_MINUTE=300

# --- CLSI ---------------------------------------------------------------
# Identifier of the breakpoint set applied to new results. Must match a set
# imported and activated via the API or `amrss import-breakpoints`.
AMRSS_ACTIVE_BREAKPOINT_VERSION=CLSI-M100-Ed36
# Blocks release of results whose QC is out of range or stale. Required true
# in production - releasing AST results without in-range QC violates CLSI.
AMRSS_ENFORCE_QC_GATING=true
AMRSS_ENFORCE_CASCADE_REPORTING=true
