# Secrets - never commit real configuration
.env
.env.*
!.env.example
*.pem
*.key

# The facility salt is the single most sensitive artefact the offline uploader
# holds: with it, the transmitted patient linkage keys become searchable against
# a small identifier space. It never leaves the facility machine, and it must
# never reach a repository.
*.amrss-salt
uploader-data/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
dist/
build/

# Local data - may contain patient information or licensed CLSI tables
# Real breakpoint tables are the laboratory's licensed property and are never
# committed — in either the CSV or the workbook it was extracted into.
data/breakpoints/*.csv
data/breakpoints/*.xlsx
data/breakpoints/*.xlsm
!data/breakpoints/*.template.csv
*.sqlite
*.db
exports/

# Node / TypeScript (apps/web, apps/uploader)
node_modules/
.next/
out/
*.tsbuildinfo
.turbo/
apps/uploader/release/
apps/uploader/dist/

# Editors / OS
.idea/
.vscode/
.DS_Store
*.swp
