# Secrets - never commit real configuration
.env
.env.*
!.env.example
*.pem
*.key

# The facility salt is the single most sensitive artefact the offline uploader
# holds: with it, the transmitted patient linkage keys become searchable against
# a small identifier space. It never leaves the facility machine, and it must
# never reach a repository.
*.amrss-salt
uploader-data/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
dist/
build/
# The uploader's packaging resources are source, not output: electron-builder
# reads its application icon from here.
!apps/uploader/build/

# Local data - may contain patient information or licensed CLSI tables
#
# A breakpoint table a laboratory drops in here is its own licensed property and
# is not committed — in either the CSV or the workbook it was extracted into.
# The default stays "ignored" so that dropping a file in this directory cannot
# put licensed material into a commit by accident.
#
# The exceptions are the two files the programme distributes deliberately: the
# empty template, and the converted CLSI M100 Ed36 table committed at the
# programme owner's direction. See data/breakpoints/README.md for what that
# means for your own CLSI licence.
data/breakpoints/*.csv
data/breakpoints/*.xlsx
data/breakpoints/*.xlsm
!data/breakpoints/*.template.csv
!data/breakpoints/clsi_m100_ed36.csv
!data/breakpoints/clsi_m100_ed36.not-converted.csv
*.sqlite
*.db
exports/

# Node / TypeScript (apps/web, apps/uploader)
node_modules/
.next/
out/
*.tsbuildinfo
.turbo/
apps/uploader/release/
apps/uploader/deployment.json
apps/uploader/dist/

# Editors / OS
.idea/
.vscode/
.DS_Store
*.swp
