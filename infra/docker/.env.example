# Copy to .env beside the compose files and fill in. Never commit the result.
#
#   cp infra/docker/.env.example infra/docker/.env
#
# Generate secrets with:
#   docker compose -f infra/docker/docker-compose.yml run --rm api python -m amrss.cli gen-secret

# Database password for the amrss role. Used by both the postgres and api
# services, so it must match in both places — which it does, because both read
# this one variable.
POSTGRES_PASSWORD=

# Signs access and refresh tokens. Changing it invalidates every session, which
# is the intended emergency response to a suspected leak. The API refuses to
# start in production while this is the development default.
AMRSS_JWT_SECRET=

# The dashboard's public origin, as a JSON array. The API rejects browser
# requests from anywhere else.
AMRSS_CORS_ORIGINS=["https://amrss.example.org"]

# development | staging | production
AMRSS_ENVIRONMENT=production
