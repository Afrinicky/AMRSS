# Copy to .env beside the compose files and fill in. Never commit the result.
#
#   cp infra/docker/.env.example infra/docker/.env
#
# This file is for the self-hosted path — the compose stack in this directory.
# The Vercel + Neon + Fly deployment sets the same variables as Vercel project
# variables and `fly secrets set` instead; see docs/DEPLOYMENT.md.
#
# Generate secrets with:
#   docker compose -f infra/docker/docker-compose.yml run --rm api python -m amrss.cli gen-secret

# Database password for the amrss role, when compose runs PostgreSQL for you.
# Unused if AMRSS_DATABASE_URL points at a managed database instead.
POSTGRES_PASSWORD=

# Where the API connects. Against Neon use the POOLED endpoint and require TLS:
#   postgresql+psycopg://USER:PASS@ep-xxx-pooler.REGION.aws.neon.tech/amrss?sslmode=require
AMRSS_DATABASE_URL=

# Where migrations run, when that differs. Against Neon this is the DIRECT
# (non-pooler) endpoint: pgbouncer in transaction mode cannot execute the
# session-level DDL some migrations need. Leave empty for a plain PostgreSQL.
AMRSS_MIGRATION_DATABASE_URL=

# Signs access and refresh tokens. Changing it invalidates every session, which
# is the intended emergency response to a suspected leak. The API refuses to
# start in production on the development default or on anything under 32
# characters.
AMRSS_JWT_SECRET=

# Browser origins the API trusts. Leave EMPTY when the dashboard calls the API
# from its own server, as it does on Vercel — no browser origin needs trusting
# and an empty list is the tighter configuration. Set it only if something calls
# the API directly from a browser: AMRSS_CORS_ORIGINS=["https://amrss.example.org"]
AMRSS_CORS_ORIGINS=[]

# development | staging | production
AMRSS_ENVIRONMENT=production
